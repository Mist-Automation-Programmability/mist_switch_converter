/* Type-checks the converter, the view model of the page and their tests (npm run test:types). Vitest itself does not check types. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/app/converters/**/*.ts",
    "src/app/workbench/**/*.test.ts",
    "vitest.config.mts"
  ]
}
